{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "astro-diya-news",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "NEWS_DB",
      "database_name": "astro-diya-news",
      "database_id": "aeca8106-2f60-45cd-b91a-1dc1794b46c1"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
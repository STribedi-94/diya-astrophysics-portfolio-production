{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "astro-diya-assets",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "astro-diya-assets",
      "remote": true
    }
  ]
}
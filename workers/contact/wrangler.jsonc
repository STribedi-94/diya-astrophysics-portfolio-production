{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "astro-diya-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "vars": {
    "TURNSTILE_HOSTNAME": "astro-diya.mdwarf.workers.dev"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "CONTACT_DB",
      "database_name": "astro-diya-contact",
      "database_id": "b8650dd4-4bcc-47ad-b741-c232a33a2388",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "astro-diya-contact-notifications",
        "binding": "CONTACT_NOTIFICATION_QUEUE"
      }
    ]
  }
}